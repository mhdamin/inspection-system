# ========================================
# FleetGuard - Environment Variables Example
# ========================================
# Copy this file to .env and update with your values
# NEVER commit .env to version control!
#
# Usage:
#   cp .env.example .env
#   Edit .env with your actual values
#   docker-compose up
# ========================================

# ========================================
# PostgreSQL Database
# ========================================
POSTGRES_DB=fleetguard
POSTGRES_USER=fleetguard_user
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_PORT=5432

# ========================================
# Spring Boot Backend
# ========================================
SPRING_PROFILES_ACTIVE=docker
BACKEND_PORT=8080

# JPA/Hibernate DDL mode
# Options: create, create-drop, update, validate, none
# Use 'update' for development, 'validate' for production
SPRING_JPA_DDL_AUTO=update

# ========================================
# JWT Configuration
# ========================================
# Generate a secure secret key (minimum 256 bits)
# Example: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ========================================
# Frontend
# ========================================
FRONTEND_PORT=80

# ========================================
# AWS S3 Configuration (Optional)
# ========================================
# Leave empty if not using S3 for image storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=fleetguard-images
AWS_REGION=ap-southeast-1

# ========================================
# Nginx
# ========================================
NGINX_WORKER_PROCESSES=auto
